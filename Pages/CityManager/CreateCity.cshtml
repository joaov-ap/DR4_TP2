@page
@model tp2.Pages.CityManager.CreateCityModel

@{
    ViewData["Title"] = "Cadastro de Cidade Turistica";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white text-center text-black">
                    <h4 class="mb-0">Cadastro de Cidade Turística</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label for="cityName" class="form-label">Nome da cidade</label>
                            <input type="text" id="cityName" name="cityName" class="form-control" placeholder="Ex: Rio de Janeiro"/>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Enviar</button>
                    </form>
                </div>
            </div>

            @if (Model.SubmittedCity != null)
            {
                <div class="alert alert-success mt-4" role="alert">
                    Cidade cadastrada: <strong>@Model.SubmittedCity</strong>
                </div>
            }
        </div>
    </div>
</div>