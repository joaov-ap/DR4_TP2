@page
@model tp2.Pages.CityManager.CreateCountryModel

@{
    ViewData["Title"] = "Cadastro de País";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white text-center text-black">
                    <h4 class="mb-0">Cadastro de Países</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        @for (int i = 0; i < Model.Input.Count; i++)
                        {
                            <div class="row mb-3">
                                <div class="col-md-8">
                                    <input asp-for="Input[i].CountryName" class="form-control" placeholder="Ex: Brasil"/>
                                    <span asp-validation-for="Input[i].CountryName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <input asp-for="Input[i].CountryCode" class="form-control" placeholder="Ex: BR"/>
                                    <span asp-validation-for="Input[i].CountryCode" class="text-danger small"></span>
                                </div>
                            </div>
                        }
                        <button type="submit" class="btn btn-primary w-100">Cadastrar Todos</button>
                    </form>
                </div>
            </div>

            @if (Model.SubmittedCountries.Any())
            {
                <div class="card mt-4 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Países Cadastrados</h5>
                    </div>
                    <ul class="list-group list-group-flush">
                        @foreach (var country in Model.SubmittedCountries)
                        {
                            <li class="list-group-item">
                                <strong>@country.CountryCode</strong> — @country.CountryName
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}